  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit --reporter=verbose",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:functional": "playwright test --project=functional",
    "test:e2e": "playwright test --project=e2e",
    "test:nonfunctional": "playwright test --project=nonfunctional",
    "test:coverage": "vitest run tests/unit tests/integration --coverage --reporter=verbose",
    "test:regression": "npm run test:unit && npm run test:integration && npm run test:functional"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
